{
  "name": "crest-forge",
  "version": "1.4.0",
  "private": true,
  "description": "Browser-only emblem editor with image tracing and a console-script bridge. Works with the Rockstar Games Social Club crew emblem editor; not affiliated with or endorsed by Rockstar Games.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "node tools/serve.mjs --open",
    "serve": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "contract:check": "node tools/contract-check.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
